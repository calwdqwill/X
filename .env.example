# ==========================================
# X/Twitter Официальное API (tweepy — только публикация)
# ==========================================
X_API_BEARER=your_bearer_token_here
X_API_KEY=your_api_key_here
X_API_SECRET=your_api_secret_here
X_ACCESS_TOKEN=your_access_token_here
X_ACCESS_SECRET=your_access_secret_here

# ==========================================
# Twikit (неофициальное чтение ленты)
# ==========================================
TWIKIT_USERNAME=your_x_username
TWIKIT_EMAIL=your_x_email@example.com
TWIKIT_PASSWORD=your_x_password
TWIKIT_COOKIES_PATH=./cookies.json

# ==========================================
# LLM API (OpenAI-совместимый endpoint)
# Подходит для: OpenAI, Grok (через прокси), Anthropic (через прокси), локальных моделей
# ==========================================
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ==========================================
# База данных
# ==========================================
DB_PATH=./x_hybrid.db

# ==========================================
# Прокси (если X/Twitter заблокирован в твоём регионе)
# Формат: http://user:pass@host:port или http://host:port
# ==========================================
# HTTP_PROXY=http://127.0.0.1:7890

# ==========================================
# Лимиты и задержки (опционально, есть дефолты в config.py)
# ==========================================
# POST_DAILY_LIMIT=5
# POST_PER_RUN_LIMIT=2
# FETCH_DELAY_MIN=8
# FETCH_DELAY_MAX=25
# POST_DELAY_MIN=40
# POST_DELAY_MAX=180
# SCHEDULER_INTERVAL_MIN=20
# SCHEDULER_INTERVAL_MAX=30
